rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // VERSÃO ENFORCE: adiciona checagem request.auth.token.email_verified == true
    // a TODO acesso (leitura e escrita) de dados do usuário.
    //
    // Deploy desta versão SOMENTE após:
    //   1. Rodar `scripts/backfill-email-verification.js`.
    //   2. EMAIL_VERIFY_ENFORCE=true em produção há ≥7 dias.
    //   3. Banner UI avisando legados há ≥14 dias.
    //
    // Comando: firebase deploy --only firestore:rules (após renomear
    // este arquivo para firestore.rules ou ajustar firebase.json).
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function billingDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)/billing/account);
    }
    // Cortesia do admin (Superpoderes → Tornar PRO / Oferecer PRO). Espelha
    // courtesyState() em api/_lib/access.js: vence qualquer estado da
    // assinatura, porque foi uma liberação explícita.
    function hasCourtesy(uid) {
      return billingDoc(uid).data.get('courtesyPermanent', false) == true
        || (billingDoc(uid).data.get('courtesyUntil', null) is timestamp
          && request.time < billingDoc(uid).data.courtesyUntil);
    }
    // Janela já paga. `paidUntil` é o campo canônico (acumula ciclos quando o
    // usuário antecipa); contas antigas só têm lastPaidAt, e para elas vale
    // lastPaidAt + 30 dias — o mesmo fallback de paidUntilMs() no backend.
    // Antes a regra só olhava lastPaidAt: quem antecipava a renovação via a
    // tela liberada e o banco recusava gravar antes da data prometida.
    function withinPaidWindow(uid) {
      return (billingDoc(uid).data.get('paidUntil', null) is timestamp
          && request.time < billingDoc(uid).data.paidUntil)
        || (billingDoc(uid).data.get('lastPaidAt', null) is timestamp
          && request.time < billingDoc(uid).data.lastPaidAt + duration.value(30, 'd'));
    }
    function hasActiveAccess(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)/billing/account)
        && (
          hasCourtesy(uid)
          || (
            // Ciclo pago protege mesmo com a fatura SEGUINTE vencida (OVERDUE),
            // como em computeAccess — quem pagou boleto no vencimento não pode
            // perder o mês. Estorno e chargeback não: o dinheiro voltou.
            withinPaidWindow(uid)
            && !(billingDoc(uid).data.get('subscriptionStatus', '') in [
              'CHARGEBACK',
              'CHARGEBACK_REVERSAL_PENDING',
              'REFUND_IN_PROGRESS'
            ])
            && !(billingDoc(uid).data.get('lastPaymentStatus', '') in [
              'REFUNDED',
              'REFUND_IN_PROGRESS',
              'REFUND_REQUESTED',
              'CHARGEBACK_REQUESTED',
              'CHARGEBACK_DISPUTE',
              'AWAITING_CHARGEBACK_REVERSAL'
            ])
          )
          || (
            !(billingDoc(uid).data.get('subscriptionStatus', '') in [
              'CHARGEBACK',
              'CHARGEBACK_REVERSAL_PENDING',
              'PAYMENT_REPROVED',
              'OVERDUE',
              'REFUND_IN_PROGRESS'
            ])
            && (
              (billingDoc(uid).data.trialEndsAt is timestamp
                && request.time < billingDoc(uid).data.trialEndsAt)
              || (
                billingDoc(uid).data.subscriptionStatus == 'ACTIVE'
                && !(billingDoc(uid).data.get('lastPaymentStatus', '') in [
                  'OVERDUE',
                  'REFUNDED',
                  'REFUND_IN_PROGRESS',
                  'REFUND_REQUESTED',
                  'CHARGEBACK_REQUESTED',
                  'CHARGEBACK_DISPUTE',
                  'AWAITING_CHARGEBACK_REVERSAL'
                ])
              )
            )
          )
        );
    }

    // Leitura também exige hasActiveAccess — fecha bypass DevTools que
    // ignorava o gate visual e lia o doc direto via SDK Firestore.
    match /users/{userId}/data/{docId} {
      allow read: if isVerified()
        && request.auth.uid == userId
        && docId == 'main'
        && hasActiveAccess(userId);
      allow create, update: if isVerified()
        && request.auth.uid == userId
        && docId == 'main'
        && request.resource.data.keys is map
        && request.resource.data.keys.size() < 450
        && hasActiveAccess(userId);
    }

    match /users/{userId}/billing/{docId} {
      allow read: if isVerified() && request.auth.uid == userId;
      allow write: if false;
    }
    match /users/{userId}/billing/{docId}/credits/{creditId} {
      allow read: if isVerified() && request.auth.uid == userId;
      allow write: if false;
    }
    match /users/{userId}/payments/{paymentId} {
      allow read: if isVerified() && request.auth.uid == userId;
      allow write: if false;
    }

    match /referralCodes/{code} {
      allow read: if false;
      allow write: if false;
    }

    match /webhookEvents/{eventId} {
      allow read: if false;
      allow write: if false;
    }

    match /rateLimits/{id} {
      allow read: if false;
      allow write: if false;
    }

    match /feedback/{id} {
      allow create: if isVerified()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 1000;
      allow read: if isVerified() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /config/{docId} {
      allow read: if isVerified();
      allow write: if false;
    }
  }
}
